PORT=5000
MONGO_URI=your_mongodb_connection_string
NODE_ENV=development

# Secrets: each must be a long random value (the server refuses to start if
# JWT_SECRET or OAUTH_STATE_SECRET is missing or shorter than 32 characters).
# Generate one per variable (use different values, and different values per environment):
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace_with_64_random_bytes
# Signs the short-lived OAuth state; must differ from JWT_SECRET.
OAUTH_STATE_SECRET=replace_with_a_different_64_random_bytes
# Session length. Default 7d. "Log out of all devices" and password changes revoke
# older tokens immediately.
JWT_EXPIRES_IN=7d

# Number of reverse-proxy hops in front of the API. Render (and most PaaS) = 1.
# Use 0/false when the API is reached directly. Never use "true" in production:
# it lets clients spoof their IP with X-Forwarded-For and bypass rate limits.
TRUST_PROXY=1

# Optional rate-limit overrides (requests per 15 minutes).
# RATE_LIMIT_MAX=100          # all routes, per client IP
# AUTH_RATE_LIMIT_MAX=10      # login/register (per IP + email), Google exchange, password change
# LEAD_IP_RATE_LIMIT_MAX=20   # public lead form, per client IP
# LEAD_KEY_RATE_LIMIT_MAX=30  # public lead form, per business (API key)

# Optional Cloudflare Turnstile captcha for public lead submissions.
# Leave empty to disable. When set, POST /api/leads requires a valid token for every
# business that has "Require captcha" on (the default); set VITE_TURNSTILE_SITE_KEY in
# the frontend too. Cloudflare's official test secrets:
#   1x0000000000000000000000000000000AA  always passes
#   2x0000000000000000000000000000000AA  always fails
TURNSTILE_SECRET_KEY=

# Google OAuth web client. Redirect URIs:
#   http://localhost:5000/api/auth/google/callback
#   http://localhost:5000/api/google/business/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Required (32+ characters) when Google OAuth is configured. Generate like JWT_SECRET.
TOKEN_ENCRYPTION_KEY=replace_with_64_random_bytes