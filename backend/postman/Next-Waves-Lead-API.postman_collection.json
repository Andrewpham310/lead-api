    {
      "name": "4. Leads (Public)",
      "item": [
        {
          "name": "Submit Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "description": "Business API key (not JWT)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"phone\": \"4161234567\",\n  \"email\": \"john@example.com\",\n  \"message\": \"I want to book a manicure this Friday\",\n  \"source\": \"website\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"]
            },
            "description": "Public lead submission from a website. Uses x-api-key header, NOT JWT."
          },
          "response": []
        },
